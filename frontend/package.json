{
  "name": "frontend",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:go": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:CGO_ENABLED='0'; New-Item -ItemType Directory -Force src-tauri/bin | Out-Null; Push-Location ../backend; go build -trimpath -ldflags='-H windowsgui -s -w' -o ../frontend/src-tauri/bin/backend-x86_64-pc-windows-msvc.exe ./cmd; Pop-Location\"",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "npm run build:go && npm run tauri build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
